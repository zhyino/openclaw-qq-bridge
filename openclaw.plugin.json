{
  "id": "openclaw-qq-bridge",
  "name": "QQ Bridge",
  "description": "QQ via OneBot 11 with hardened outbound whitelist + owner commands + slang learning",
  "version": "0.3.3",
  "channels": [
    "onebot"
  ],
  "channelEnvVars": {
    "onebot": [
      "ONEBOT_WS_URL",
      "ONEBOT_HTTP_URL",
      "ONEBOT_ACCESS_TOKEN",
      "ONEBOT_SHARED_DIR",
      "ONEBOT_CONTAINER_SHARED_DIR"
    ]
  },
  "configSchema": {
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "channelConfigs": {
    "onebot": {
      "label": "OneBot",
      "description": "OneBot 11 channel settings for NapCat/go-cqhttp",
      "schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "name": {
            "type": "string",
            "description": "Display name for this account"
          },
          "wsUrl": {
            "type": "string",
            "description": "OneBot WebSocket URL"
          },
          "httpUrl": {
            "type": "string",
            "description": "OneBot HTTP API URL"
          },
          "accessToken": {
            "type": "string",
            "description": "Sensitive access token for the OneBot API; keep endpoints on localhost or a trusted network"
          },
          "sharedDir": {
            "type": "string",
            "description": "Host directory mounted into NapCat for outbound media/files"
          },
          "containerSharedDir": {
            "type": "string",
            "description": "Container path corresponding to the shared host directory"
          },
          "allowFrom": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Allowed sources (e.g. private:123, group:456). Configure this for trusted QQ users or groups before enabling text commands."
          },
          "groupAllowFrom": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "deprecated": true,
            "description": "Deprecated legacy group allow-list; use allowFrom instead"
          },
          "groupAutoReact": {
            "type": "boolean",
            "default": false,
            "description": "Automatically add a reaction to inbound group messages"
          },
          "groupAutoReactEmojiId": {
            "description": "QQ/NapCat emoji id used for automatic group reactions",
            "default": 1,
            "oneOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ]
          },
          "ownerQQ": {
            "type": "string",
            "pattern": "^\\d+$",
            "description": "Owner QQ number. Only this account may run control commands (/silent, /active, /role). Leaving it empty disables every control command."
          },
          "outboundAllow": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "description": "Outbound allow-list (private:<QQ>, group:<id>, or group:*). The agent can only send to these targets. Empty means every target is allowed, which is not recommended."
          },
          "outboundDeny": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "description": "Outbound deny-list. Always wins over outboundAllow."
          },
          "replyAudit": {
            "type": "boolean",
            "default": true,
            "description": "Block replies that contain local paths or credential-like patterns before they leave the process."
          },
          "mediaAllowDirs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "description": "Extra directories whose files may be sent as media, in addition to sharedDir. Files outside every allowed root are rejected."
          },
          "configWrites": {
            "type": "boolean",
            "description": "Allow channel-initiated config writes"
          },
          "commands": {
            "$ref": "#/$defs/commands"
          },
          "textChunkLimit": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "chunkMode": {
            "type": "string",
            "enum": [
              "length",
              "newline"
            ]
          },
          "blockStreaming": {
            "type": "boolean"
          },
          "blockStreamingCoalesce": {
            "$ref": "#/$defs/blockStreamingCoalesce",
            "description": "Block streaming coalescing options for OneBot replies"
          },
          "streaming": {
            "$ref": "#/$defs/streaming"
          },
          "accounts": {
            "type": "object",
            "description": "Additional OneBot accounts",
            "additionalProperties": {
              "$ref": "#/$defs/account"
            }
          },
          "qzoneWrite": {
            "type": "boolean",
            "default": false,
            "description": "Enable QQ-zone / profile write tools (send/delete/like/comment/delete/profile/status). Off by default; when off the agent cannot see or call these tools."
          },
          "muteSystemNotices": {
            "type": "boolean",
            "default": true,
            "description": "Mute system notices ([OpenClaw] ... / 💾 Learned: ...) from reaching the chat. Default true."
          },
          "ignoreFrom": {
            "type": "array",
            "items": { "type": "string" },
            "description": "QQ ids whose messages are ignored entirely (bot-loop guard, manual list)."
          },
          "ignoreBots": {
            "type": "boolean",
            "default": true,
            "description": "Rate-limit group messages from members SnowLuma flags `is_robot: true`. Default true: a bot's message is admitted once per botMinIntervalSec, the rest are dropped — so the agent can still talk to a bot occasionally without looping into a flood."
          },
          "botMinIntervalSec": {
            "type": "integer",
            "minimum": 1,
            "default": 60,
            "description": "Minimum seconds between admitted messages from the same bot (default 60)."
          }
        },
        "additionalProperties": false,
        "$defs": {
          "blockStreamingCoalesce": {
            "type": "object",
            "properties": {
              "minChars": {
                "type": "integer",
                "exclusiveMinimum": 0
              },
              "maxChars": {
                "type": "integer",
                "exclusiveMinimum": 0
              },
              "idleMs": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          },
          "commands": {
            "type": "object",
            "properties": {
              "native": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "string",
                    "const": "auto"
                  }
                ]
              },
              "nativeSkills": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "string",
                    "const": "auto"
                  }
                ]
              }
            },
            "additionalProperties": false
          },
          "streaming": {
            "type": "object",
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "off",
                  "partial",
                  "block",
                  "progress"
                ]
              },
              "chunkMode": {
                "type": "string",
                "enum": [
                  "length",
                  "newline"
                ]
              },
              "block": {
                "type": "object",
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  },
                  "coalesce": {
                    "$ref": "#/$defs/blockStreamingCoalesce"
                  }
                },
                "additionalProperties": false
              },
              "preview": {
                "type": "object",
                "properties": {
                  "toolProgress": {
                    "type": "boolean"
                  }
                },
                "additionalProperties": false
              },
              "nativeTransport": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          },
          "account": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "name": {
                "type": "string"
              },
              "wsUrl": {
                "type": "string"
              },
              "httpUrl": {
                "type": "string"
              },
              "accessToken": {
                "type": "string",
                "description": "Sensitive access token for the OneBot API; keep endpoints on localhost or a trusted network"
              },
              "sharedDir": {
                "type": "string"
              },
              "containerSharedDir": {
                "type": "string"
              },
              "allowFrom": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Allowed sources (e.g. private:123, group:456). Configure this for trusted QQ users or groups before enabling text commands."
              },
              "groupAllowFrom": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "deprecated": true
              },
              "groupAutoReact": {
                "type": "boolean",
                "default": false
              },
              "groupAutoReactEmojiId": {
                "default": 1,
                "oneOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "ownerQQ": {
                "type": "string",
                "pattern": "^\\d+$",
                "description": "Owner QQ number. Only this account may run control commands (/silent, /active, /role). Leaving it empty disables every control command."
              },
              "outboundAllow": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": [],
                "description": "Outbound allow-list (private:<QQ>, group:<id>, or group:*). The agent can only send to these targets. Empty means every target is allowed, which is not recommended."
              },
              "outboundDeny": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": [],
                "description": "Outbound deny-list. Always wins over outboundAllow."
              },
              "replyAudit": {
                "type": "boolean",
                "default": true,
                "description": "Block replies that contain local paths or credential-like patterns before they leave the process."
              },
              "mediaAllowDirs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": [],
                "description": "Extra directories whose files may be sent as media, in addition to sharedDir. Files outside every allowed root are rejected."
              },
              "configWrites": {
                "type": "boolean"
              },
              "commands": {
                "$ref": "#/$defs/commands"
              },
              "textChunkLimit": {
                "type": "integer",
                "exclusiveMinimum": 0
              },
              "chunkMode": {
                "type": "string",
                "enum": [
                  "length",
                  "newline"
                ]
              },
              "blockStreaming": {
                "type": "boolean"
              },
              "blockStreamingCoalesce": {
                "$ref": "#/$defs/blockStreamingCoalesce"
              },
              "streaming": {
                "$ref": "#/$defs/streaming"
              },
              "qzoneWrite": {
                "type": "boolean",
                "default": false,
                "description": "Enable QQ-zone / profile write tools (send/delete/like/comment/delete/profile/status). Off by default; when off the agent cannot see or call these tools."
              },
              "muteSystemNotices": {
                "type": "boolean",
                "default": true,
                "description": "Mute system notices ([OpenClaw] ... / 💾 Learned: ...) from reaching the chat. Default true."
              },
              "ignoreFrom": {
                "type": "array",
                "items": { "type": "string" },
                "description": "QQ ids whose messages are ignored entirely (bot-loop guard, manual list)."
              },
              "ignoreBots": {
                "type": "boolean",
                "default": true,
                "description": "Rate-limit group messages from members SnowLuma flags `is_robot: true`. Default true: a bot's message is admitted once per botMinIntervalSec, the rest are dropped — so the agent can still talk to a bot occasionally without looping into a flood."
              },
              "botMinIntervalSec": {
                "type": "integer",
                "minimum": 1,
                "default": 60,
                "description": "Minimum seconds between admitted messages from the same bot (default 60)."
              }
            },
            "additionalProperties": false
          }
        }
      },
      "uiHints": {
        "wsUrl": {
          "label": "WebSocket URL",
          "placeholder": "ws://localhost:3001"
        },
        "httpUrl": {
          "label": "HTTP API URL",
          "placeholder": "http://localhost:3001"
        },
        "accessToken": {
          "label": "Access token",
          "sensitive": true
        },
        "sharedDir": {
          "label": "Shared directory"
        },
        "containerSharedDir": {
          "label": "Container shared directory",
          "placeholder": "/shared"
        }
      }
    }
  },
  "doctorContract": {
    "stateMigrations": false
  }
}
